<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Darbar_E_Saltanat royal palette: deep navy, gold accents, maroon highlights, clean white content -->
    <Color x:Key="NavyDarkColor">#0B1020</Color>
    <Color x:Key="NavyColor">#111831</Color>
    <Color x:Key="NavyLightColor">#1A2342</Color>
    <Color x:Key="GoldColor">#D4A72C</Color>
    <Color x:Key="GoldLightColor">#F0D68A</Color>
    <Color x:Key="MaroonColor">#9B1C31</Color>
    <SolidColorBrush x:Key="NavyDarkBrush" Color="{StaticResource NavyDarkColor}"/>
    <SolidColorBrush x:Key="NavyBrush" Color="{StaticResource NavyColor}"/>
    <SolidColorBrush x:Key="NavyLightBrush" Color="{StaticResource NavyLightColor}"/>
    <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource GoldColor}"/>
    <SolidColorBrush x:Key="GoldLightBrush" Color="{StaticResource GoldLightColor}"/>
    <SolidColorBrush x:Key="MaroonBrush" Color="{StaticResource MaroonColor}"/>
    <SolidColorBrush x:Key="ContentBrush" Color="#F4F5F8"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#15803D"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#B45309"/>

    <Style TargetType="Window" x:Key="RoyalWindow">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Background" Value="{StaticResource ContentBrush}"/>
    </Style>

    <!-- Touch-friendly base button (min 48px high) -->
    <Style x:Key="BaseButton" TargetType="Button">
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="Padding" Value="18,8"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.9"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.75"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource NavyBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource GoldLightBrush}"/>
    </Style>
    <Style x:Key="GoldButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource GoldBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource NavyDarkBrush}"/>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource MaroonBrush}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="KeypadButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource NavyLightBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="MinHeight" Value="64"/>
    </Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#CBD5E1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Margin" Value="0,2"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="BorderBrush" Value="#CBD5E1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="BorderBrush" Value="#CBD5E1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,12,0,4"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#334155"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="BorderBrush" Value="#E2E8F0"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="Heading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Georgia"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
    </Style>
</ResourceDictionary>
