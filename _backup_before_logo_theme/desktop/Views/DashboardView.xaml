<UserControl x:Class="DarbarESaltanat.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding Periods}" SelectedItem="{Binding Period}" Width="160" MinHeight="44" FontSize="15" Margin="0,0,8,0"/>
                    <Button Content="↻" Style="{StaticResource PrimaryButton}" Width="48" Command="{Binding RefreshCommand}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding Greeting}" Style="{StaticResource Heading}"/>
                    <TextBlock Text="{Binding LocalTime}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,16"/>
                </StackPanel>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Kpis}" Margin="-6,0">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="6" BorderBrush="{StaticResource GoldBrush}" BorderThickness="4,0,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding Value}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource NavyBrush}"/>
                                <TextBlock Text="{Binding Hint}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Payments received" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding Payments}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <DockPanel Margin="0,4"><TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="SemiBold"/><TextBlock Text="{Binding Label}"/></DockPanel>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Top-selling items" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding TopItems}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <DockPanel Margin="0,4">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Hint}" Foreground="{StaticResource MutedTextBrush}" Width="100" TextAlignment="Right"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="SemiBold" Width="80" TextAlignment="Right"/>
                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="This terminal" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
                    <TextBlock><Run Text="Sync: " Foreground="{StaticResource MutedTextBrush}"/><Run Text="{Binding Sync.Label, Mode=OneWay}"/></TextBlock>
                    <TextBlock><Run Text="Device ID: " Foreground="{StaticResource MutedTextBrush}"/><Run Text="{Binding DeviceId, Mode=OneWay}" FontFamily="Consolas"/></TextBlock>
                    <TextBlock><Run Text="Branch: " Foreground="{StaticResource MutedTextBrush}"/><Run Text="{Binding BranchUuid, Mode=OneWay}" FontFamily="Consolas"/></TextBlock>
                    <TextBlock Text="{Binding VatSummary}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
