<UserControl x:Class="DarbarESaltanat.Desktop.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.InputBindings>
        <KeyBinding Key="F6" Command="{Binding SendKotCommand}"/>
        <KeyBinding Key="F7" Command="{Binding DiscountCommand}"/>
        <KeyBinding Key="F8" Command="{Binding PayCommand}"/>
        <KeyBinding Key="F11" Command="{Binding BillCommand}"/>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewTakeawayCommand}"/>
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding NewDineInCommand}"/>
        <KeyBinding Key="H" Modifiers="Control" Command="{Binding HoldCommand}"/>
        <KeyBinding Key="U" Modifiers="Control" Command="{Binding CustomerCommand}"/>
        <KeyBinding Key="V" Modifiers="Control" Command="{Binding PrintVoucherCommand}"/>
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding ReprintCommand}"/>
    </UserControl.InputBindings>
    <UserControl.Resources>
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Background" Value="{StaticResource NavyBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource GoldLightBrush}"/>
        </Style>
        <Style x:Key="TotalLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/></Style>
    </UserControl.Resources>
    <DockPanel>
        <!-- Top bar: new orders + open orders strip -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="+ Takeaway (Ctrl+N)" Style="{StaticResource GoldButton}" Margin="0,0,6,0" Command="{Binding NewTakeawayCommand}"/>
                <Button Content="+ Dine-in (Ctrl+D)" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" Command="{Binding NewDineInCommand}"/>
                <Button Content="+ Delivery" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0" Command="{Binding NewDeliveryCommand}"/>
            </StackPanel>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding ActiveOrders}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource BaseButton}" Background="White" BorderBrush="#CBD5E1" Margin="0,0,6,0" Padding="10,4"
                                    Command="{Binding DataContext.OpenOrderCommand, ElementName=Root}" CommandParameter="{Binding}">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" Foreground="{StaticResource NavyBrush}">
                                        <Run Text="{Binding TableName, TargetNullValue='Takeaway', Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="{StaticResource MutedTextBrush}" Text="{Binding Status}"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- Cart (right) -->
        <Border DockPanel.Dock="Right" Width="440" Style="{StaticResource Card}" Padding="14" Margin="12,0,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="✕" ToolTip="Close this order view" Style="{StaticResource NavButton}" Foreground="{StaticResource MutedTextBrush}" MinHeight="32" Padding="8,0" Command="{Binding CloseOrderCommand}"/>
                        <TextBlock Text="{Binding OrderTitle}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource NavyBrush}"/>
                    </DockPanel>
                    <TextBlock Text="{Binding OrderSubtitle}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,8"/>
                </StackPanel>

                <!-- Actions + totals at the bottom -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Background="#F8FAFC" CornerRadius="8" Padding="10" Margin="0,8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Subtotal" Style="{StaticResource TotalLabel}"/><TextBlock Grid.Column="1" Text="{Binding SubtotalText}"/>
                            <TextBlock Grid.Row="1" Text="{Binding DiscountLabel}" Style="{StaticResource TotalLabel}" Visibility="{Binding ShowDiscount, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DiscountText}" Foreground="{StaticResource MaroonBrush}" Visibility="{Binding ShowDiscount, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Grid.Row="2" Text="{Binding ServiceChargeLabel}" Style="{StaticResource TotalLabel}" Visibility="{Binding ShowServiceCharge, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ServiceChargeText}" Visibility="{Binding ShowServiceCharge, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Grid.Row="3" Text="{Binding VatLabel}" Style="{StaticResource TotalLabel}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding VatText}"/>
                            <TextBlock Grid.Row="4" Text="Delivery charge" Style="{StaticResource TotalLabel}" Visibility="{Binding ShowDelivery, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DeliveryText}" Visibility="{Binding ShowDelivery, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Grid.Row="5" Text="Round off" Style="{StaticResource TotalLabel}" Visibility="{Binding ShowRoundOff, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding RoundOffText}" Visibility="{Binding ShowRoundOff, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Grid.Row="6" Text="TOTAL" FontSize="22" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding TotalText}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="7" Text="Paid" Style="{StaticResource TotalLabel}" Visibility="{Binding ShowPaid, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding PaidText}" Visibility="{Binding ShowPaid, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Grid.Row="8" Text="Due" FontWeight="Bold" Foreground="{StaticResource MaroonBrush}" Visibility="{Binding ShowPaid, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding DueText}" FontWeight="Bold" Foreground="{StaticResource MaroonBrush}" Visibility="{Binding ShowPaid, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>
                    <WrapPanel IsEnabled="{Binding IsEditable}">
                        <Button Content="Customer" Style="{StaticResource SmallButton}" Command="{Binding CustomerCommand}"/>
                        <Button Content="Note / guests" Style="{StaticResource SmallButton}" Command="{Binding DetailsCommand}"/>
                        <Button Content="Discount F7" Style="{StaticResource SmallButton}" Command="{Binding DiscountCommand}" IsEnabled="{Binding CanDiscount}"/>
                        <Button Content="Hold" Style="{StaticResource SmallButton}" Command="{Binding HoldCommand}"/>
                        <Button Content="Resume" Style="{StaticResource SmallButton}" Command="{Binding ResumeCommand}"/>
                        <Button Content="Move table" Style="{StaticResource SmallButton}" Command="{Binding TransferCommand}" IsEnabled="{Binding CanTransfer}"/>
                        <Button Content="Merge" Style="{StaticResource SmallButton}" Command="{Binding MergeCommand}" IsEnabled="{Binding CanTransfer}"/>
                        <Button Content="Split bill" Style="{StaticResource SmallButton}" Command="{Binding SplitCommand}" IsEnabled="{Binding CanTransfer}"/>
                        <Button Content="Void" Style="{StaticResource SmallButton}" Background="{StaticResource MaroonBrush}" Foreground="White" Command="{Binding VoidCommand}" IsEnabled="{Binding CanVoid}"/>
                    </WrapPanel>
                    <UniformGrid Columns="3" Margin="0,4,0,0">
                        <Button Content="KOT  F6" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" Command="{Binding SendKotCommand}" IsEnabled="{Binding IsEditable}"/>
                        <Button Content="Bill  F11" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" Command="{Binding BillCommand}" IsEnabled="{Binding IsEditable}"/>
                        <Button Content="PAY  F8" Style="{StaticResource GoldButton}" FontSize="17" Command="{Binding PayCommand}" IsEnabled="{Binding IsEditable}"/>
                    </UniformGrid>
                    <DockPanel Margin="0,4,0,0" Visibility="{Binding HasOrder, Converter={StaticResource BoolToVis}}">
                        <Button DockPanel.Dock="Left" Content="🖨️ Print Voucher" Style="{StaticResource NavButton}" Foreground="{StaticResource NavyBrush}" FontWeight="SemiBold" MinHeight="32" Command="{Binding PrintVoucherCommand}"/>
                        <Button DockPanel.Dock="Right" Content="Reprint (Ctrl+P)" Style="{StaticResource NavButton}" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" MinHeight="32" Command="{Binding ReprintCommand}"/>
                    </DockPanel>
                </StackPanel>

                <!-- Cart lines -->
                <ListBox ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" BorderThickness="0" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCancelled}" Value="True"><Setter Property="TextDecorations" Value="Strikethrough"/><Setter Property="Foreground" Value="Gray"/></DataTrigger>
                                        </Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Details}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Visibility="{Binding HasDetails, Converter={StaticResource BoolToVis}}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <Border CornerRadius="4" Padding="6,1" Background="#EEF2FF"><TextBlock Text="{Binding StatusLabel}" FontSize="11"/></Border>
                                        <Button Content="note" Style="{StaticResource NavButton}" Foreground="{StaticResource NavyLightBrush}" MinHeight="22" Padding="6,0" FontSize="11"
                                                Command="{Binding DataContext.NoteCommand, ElementName=Root}" CommandParameter="{Binding}" Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}"/>
                                        <Button Content="remove" Style="{StaticResource NavButton}" Foreground="{StaticResource MaroonBrush}" MinHeight="22" Padding="6,0" FontSize="11"
                                                Command="{Binding DataContext.RemoveCommand, ElementName=Root}" CommandParameter="{Binding}" Visibility="{Binding IsCancelled, Converter={StaticResource InverseBoolToVis}}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Visibility="{Binding IsCancelled, Converter={StaticResource InverseBoolToVis}}">
                                    <Button Content="−" Width="38" MinHeight="38" Style="{StaticResource BaseButton}" Background="#E2E8F0" Padding="0"
                                            Command="{Binding DataContext.DecreaseCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                    <TextBlock Text="{Binding Quantity}" Width="34" TextAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                                    <Button Content="+" Width="38" MinHeight="38" Style="{StaticResource GoldButton}" Padding="0"
                                            Command="{Binding DataContext.IncreaseCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Amount}" Width="92" TextAlignment="Right" FontWeight="SemiBold" VerticalAlignment="Top" Margin="6,8,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Categories (left) -->
        <ListBox DockPanel.Dock="Left" Width="170" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name"
                 Background="{StaticResource NavyBrush}" Foreground="White" BorderThickness="0" FontSize="15" Margin="0,0,12,0">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="12,12"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource GoldBrush}"/><Setter Property="Foreground" Value="{StaticResource NavyDarkBrush}"/></Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <!-- Search + message + menu tiles -->
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="↻" ToolTip="Reload menu" Style="{StaticResource PrimaryButton}" Width="48" Margin="6,0,0,0" Command="{Binding ReloadCatalogCommand}"/>
                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" FontSize="16"
                         ToolTip="Search by name, SKU or scan a barcode, then press Enter">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding AddFromSearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
            <Border DockPanel.Dock="Top" CornerRadius="8" Padding="10" Margin="0,0,0,8" Visibility="{Binding Message, Converter={StaticResource NullToVis}}">
                <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#E8F5EC"/>
                    <Style.Triggers><DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Background" Value="#FDECEF"/></DataTrigger></Style.Triggers></Style></Border.Style>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Tiles}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="158" Height="114" Margin="0,0,8,8" Style="{StaticResource BaseButton}" Background="White" Padding="8,7"
                                    Command="{Binding DataContext.AddTileCommand, ElementName=Root}" CommandParameter="{Binding}">
                                <Button.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.15"/></Button.Effect>
                                <Grid Width="140">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource NavyBrush}" MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding NameBn}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Visibility="{Binding NameBn, Converter={StaticResource NullToVis}}"/>
                                    </StackPanel>
                                    <DockPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0,4,0,0">
                                        <TextBlock DockPanel.Dock="Right" Text="⋯" ToolTip="Has sizes / add-ons" Foreground="{StaticResource GoldBrush}" FontWeight="Bold" FontSize="14" Margin="4,0,0,0" Visibility="{Binding HasOptions, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding PriceText}" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource MaroonBrush}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <Border Grid.RowSpan="2" Background="#CC0B1020" CornerRadius="6" Visibility="{Binding IsAvailable, Converter={StaticResource InverseBoolToVis}}">
                                        <TextBlock Text="OUT OF STOCK" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </DockPanel>
</UserControl>
