<UserControl x:Class="DarbarESaltanat.Desktop.Views.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Orders" Style="{StaticResource Heading}"/>
            <TextBlock Text="{Binding Totals}" Foreground="{StaticResource MutedTextBrush}"/>
        </StackPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <ComboBox ItemsSource="{Binding Periods}" SelectedItem="{Binding Period}" Width="160" MinHeight="44" Margin="0,0,8,0" FontSize="15"/>
            <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}" Width="160" MinHeight="44" Margin="0,0,8,0" FontSize="15"/>
            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="240" Margin="0,0,8,0" ToolTip="Order no, customer or table">
                <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding RefreshCommand}"/></TextBox.InputBindings>
            </TextBox>
            <Button Content="Search" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}"/>
        </WrapPanel>
        <Border DockPanel.Dock="Top" Background="#FFF7E6" CornerRadius="8" Padding="10" Margin="0,0,0,8" Visibility="{Binding Message, Converter={StaticResource NullToVis}}">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
        </Border>
        <Border DockPanel.Dock="Right" Width="420" Style="{StaticResource Card}" Margin="12,0,0,0">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Button Content="Open in POS" Style="{StaticResource PrimaryButton}" Margin="0,0,6,6" Command="{Binding OpenInPosCommand}"/>
                    <Button Content="🖨️ Print Voucher" Style="{StaticResource PrimaryButton}" Margin="0,0,6,6" Command="{Binding PrintVoucherCommand}" IsEnabled="{Binding CanReprint}"/>
                    <Button Content="Reprint" Style="{StaticResource PrimaryButton}" Margin="0,0,6,6" Command="{Binding ReprintCommand}" IsEnabled="{Binding CanReprint}"/>
                    <Button Content="Refund" Style="{StaticResource GoldButton}" Margin="0,0,6,6" Command="{Binding RefundCommand}" IsEnabled="{Binding CanRefund}"/>
                    <Button Content="Void" Style="{StaticResource DangerButton}" Margin="0,0,6,6" Command="{Binding VoidCommand}" IsEnabled="{Binding CanVoid}"/>
                </WrapPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding DetailText}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="40" FontSize="14" SelectionMode="Single" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Order" Binding="{Binding OrderNo}" Width="190"/>
                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="130"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90"/>
                <DataGridTextColumn Header="Table" Binding="{Binding Table}" Width="70"/>
                <DataGridTextColumn Header="Customer" Binding="{Binding Customer}" Width="*"/>
                <DataGridTextColumn Header="Items" Binding="{Binding Items}" Width="60"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                <DataGridTextColumn Header="Payment" Binding="{Binding Payment}" Width="110"/>
                <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
