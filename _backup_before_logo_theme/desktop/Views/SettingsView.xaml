<UserControl x:Class="DarbarESaltanat.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
        <TextBlock Text="Settings" Style="{StaticResource Heading}"/>
        <TextBlock Text="Saved to this computer immediately and synced to the server in the background." Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,12"/>

        <Border CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#E8F5EC"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Message}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                    <DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Background" Value="#FDECEF"/></DataTrigger>
                </Style.Triggers></Style></Border.Style>
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" IsEnabled="{Binding CanEditRestaurant}">
                <StackPanel>
                    <TextBlock Text="Restaurant &amp; receipt" FontWeight="Bold" FontSize="16"/>
                    <TextBlock Text="Restaurant name" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding RestaurantName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Address" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Phone" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Receipt header" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ReceiptHeader, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Receipt footer" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ReceiptFooter, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Receipt printer width (mm)" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding ReceiptWidths}" SelectedItem="{Binding ReceiptWidthMm}" MinHeight="44"/>
                    <TextBlock Text="Theme" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" MinHeight="44"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" IsEnabled="{Binding CanEditRestaurant}">
                <StackPanel>
                    <TextBlock Text="Tax, charges &amp; security" FontWeight="Bold" FontSize="16"/>
                    <TextBlock Text="VAT rate (%)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding VatRate, UpdateSourceTrigger=PropertyChanged}"/>
                    <CheckBox Content="Menu prices include VAT" IsChecked="{Binding VatInclusive}" Margin="0,8,0,0"/>
                    <TextBlock Text="Service charge (%)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ServiceChargeRate, UpdateSourceTrigger=PropertyChanged}"/>
                    <CheckBox Content="Service charge on dine-in only" IsChecked="{Binding ServiceChargeDineInOnly}" Margin="0,8,0,0"/>
                    <TextBlock Text="Max discount without manager override (%)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding MaxDiscount, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Auto-lock after inactivity (minutes)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding AutoLockMinutes, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Sync interval (seconds)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SyncIntervalSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="Save settings" Style="{StaticResource PrimaryButton}" Margin="0,18,0,0" Command="{Binding SaveRestaurantCommand}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Style="{StaticResource Card}" Margin="0,20,0,0" IsEnabled="{Binding CanEditSync}">
            <StackPanel>
                <TextBlock Text="Server sync" FontWeight="Bold" FontSize="16"/>
                <TextBlock Text="Register this computer in the web portal (Devices &amp; Sync) and paste the Device ID and token here." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
                <TextBlock Text="API base URL (e.g. https://darbaresaltanat.com/api/v1)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Device ID" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding DeviceId, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/>
                <TextBlock Style="{StaticResource FieldLabel}">
                    <Run Text="Device token"/>
                    <Run Text="{Binding HasDeviceToken, StringFormat=' (token stored: {0}; leave blank to keep)', Mode=OneWay}" FontWeight="Normal" Foreground="{StaticResource MutedTextBrush}"/>
                </TextBlock>
                <TextBox Text="{Binding NewDeviceToken, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/>
                <Button Content="Save sync settings" Style="{StaticResource GoldButton}" Margin="0,18,0,0" HorizontalAlignment="Left" Command="{Binding SaveSyncCommand}"/>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,20,0,0" IsEnabled="{Binding CanEditRestaurant}">
            <StackPanel>
                <TextBlock Text="Printers (this computer only)" FontWeight="Bold" FontSize="16"/>
                <TextBlock Text="Choose the Windows printer queue of each thermal printer. With no printer selected, receipts and KOTs are shown on screen." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
                <TextBlock Text="Receipt / bill printer" Style="{StaticResource FieldLabel}"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Test" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Command="{Binding TestPrinterCommand}" CommandParameter="receipt"/>
                    <ComboBox ItemsSource="{Binding InstalledPrinters}" SelectedItem="{Binding ReceiptPrinter}" MinHeight="44"/>
                </DockPanel>
                <TextBlock Text="Kitchen (KOT) printer" Style="{StaticResource FieldLabel}"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Test" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Command="{Binding TestPrinterCommand}" CommandParameter="kitchen"/>
                    <ComboBox ItemsSource="{Binding InstalledPrinters}" SelectedItem="{Binding KitchenPrinter}" MinHeight="44"/>
                </DockPanel>
                <CheckBox Content="Open the cash drawer (connected to the receipt printer) on cash payments and refunds" IsChecked="{Binding CashDrawerEnabled}" Margin="0,12,0,0"/>
                <Button Content="Save printer settings" Style="{StaticResource GoldButton}" Margin="0,16,0,0" HorizontalAlignment="Left" Command="{Binding SavePrintersCommand}"/>
            </StackPanel>
        </Border>
    </StackPanel>
    </ScrollViewer>
</UserControl>
