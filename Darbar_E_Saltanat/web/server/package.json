{
  "name": "darbar-e-saltanat-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Darbar_E_Saltanat REST API (Express + Sequelize + MySQL 8)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "test": "vitest run",
    "dev:sqlite": "node scripts/dev-sqlite.mjs --port 4000 --register-devices 1"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "sequelize": "^6.37.3",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "sqlite3": "^5.1.7",
    "supertest": "^7.0.0",
    "vitest": "^2.1.0"
  }
}
