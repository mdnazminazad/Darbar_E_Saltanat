<UserControl x:Class="DarbarESaltanat.Desktop.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DarbarESaltanat.Desktop.ViewModels"
             d:DataContext="{d:DesignInstance vm:UsersViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <!-- Main Content -->
        <DockPanel LastChildFill="True">
            <!-- Header bar -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20,16" Margin="0,0,0,16" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Vertical" DockPanel.Dock="Left">
                        <TextBlock Text="User Management" Style="{StaticResource Heading}"/>
                        <TextBlock Text="Manage desktop and portal staff accounts, roles, and security policies" Foreground="{DynamicResource MutedTextBrush}" FontSize="13" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBox Width="240" MinHeight="42" Margin="0,0,12,0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" Padding="12,0" Background="{DynamicResource CardAltBrush}" BorderBrush="{DynamicResource InputBorderBrush}"/>
                        <Button Content="↻ Refresh" Style="{StaticResource NavButton}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" MinHeight="42" Padding="14,0"/>
                        <Button Content="+ New User" Style="{StaticResource GoldButton}" Command="{Binding OpenNewUserDialogCommand}" MinHeight="42" Padding="18,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Alerts -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Border Background="{DynamicResource ErrorBannerBrush}" BorderBrush="{StaticResource MaroonBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerTextBrush}" FontWeight="SemiBold"/>
                </Border>
                <Border Background="{DynamicResource OkBannerBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10"
                        Visibility="{Binding SuccessMessage, Converter={StaticResource NullToVis}}">
                    <TextBlock Text="{Binding SuccessMessage}" Foreground="{DynamicResource SuccessTextBrush}" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>

            <!-- Users DataGrid -->
            <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="16" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                <DataGrid ItemsSource="{Binding Users}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                          Background="{DynamicResource CardBrush}" RowHeight="52" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="FULL NAME" Binding="{Binding FullName}" Width="1.5*" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="USERNAME" Binding="{Binding Username}" Width="1.2*"/>
                        <DataGridTextColumn Header="ROLE" Binding="{Binding RoleName}" Width="1.2*"/>
                        <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="1.5*"/>
                        <DataGridTextColumn Header="PHONE" Binding="{Binding Phone}" Width="1.1*"/>
                        <DataGridTemplateColumn Header="STATUS" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="8,4" HorizontalAlignment="Left"
                                            Background="{Binding IsActive, Converter={StaticResource TableStatusBrush}}">
                                        <TextBlock Text="{Binding IsActive, Converter={StaticResource BoolToVis}, ConverterParameter='Active:Inactive'}"
                                                   Foreground="White" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ACTIONS" Width="260">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="Edit" Margin="0,0,6,0" Padding="10,4" MinHeight="32" FontSize="12"
                                                Style="{StaticResource NavButton}"
                                                Command="{Binding DataContext.OpenEditUserDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Reset Pass" Margin="0,0,6,0" Padding="10,4" MinHeight="32" FontSize="12"
                                                Style="{StaticResource GoldButton}"
                                                Command="{Binding DataContext.OpenResetDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="{Binding IsActive, Converter={StaticResource BoolToVis}, ConverterParameter='Deactivate:Activate'}"
                                                Padding="10,4" MinHeight="32" FontSize="12"
                                                Style="{StaticResource DangerButton}"
                                                Command="{Binding DataContext.ToggleStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <!-- New / Edit User Dialog Modal -->
        <Grid Background="#B30B1020" Visibility="{Binding ShowDialog, Converter={StaticResource BoolToVis}}">
            <Border Width="520" Background="{DynamicResource CardBrush}" CornerRadius="16" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderBrush="{StaticResource GoldBrush}" BorderThickness="1.5">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="620">
                    <StackPanel>
                        <TextBlock Text="{Binding DialogTitle}" Style="{StaticResource Heading}" Margin="0,0,0,16"/>

                        <TextBlock Text="Username *" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding FormUsername, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditUsername}" Margin="0,0,0,4"/>
                        <TextBlock Text="3–60 chars (letters, digits, dot, dash, underscore). Super Admin can change username." Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,0,0,10"/>

                        <TextBlock Text="Full Name *" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding FormFullName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                        <TextBlock Text="Role *" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" DisplayMemberPath="Name" MinHeight="42" Margin="0,0,0,10"/>

                        <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                        <TextBlock Text="Phone Number" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                        <!-- Password field: required on create, optional on edit -->
                        <TextBlock Text="{Binding PasswordFieldLabel}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding FormPassword, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                        <TextBlock Text="Min 8 chars, uppercase, lowercase, number, and special character." Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,0,0,10"/>

                        <CheckBox Content="Force password change on next login" IsChecked="{Binding FormMustChangePassword}" Margin="0,0,0,10"/>
                        <CheckBox Content="User account is active" IsChecked="{Binding FormIsActive}" Margin="0,0,0,20"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" Style="{StaticResource NavButton}" Command="{Binding CloseDialogCommand}" Margin="0,0,10,0"/>
                            <Button Content="Save User" Style="{StaticResource PrimaryButton}" Command="{Binding SaveUserCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Reset Password Dialog Modal -->
        <Grid Background="#B30B1020" Visibility="{Binding ShowResetDialog, Converter={StaticResource BoolToVis}}">
            <Border Width="460" Background="{DynamicResource CardBrush}" CornerRadius="16" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderBrush="{StaticResource MaroonBrush}" BorderThickness="1.5">
                <StackPanel>
                    <TextBlock Text="Reset User Password" Style="{StaticResource Heading}" Foreground="{DynamicResource DangerTextBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding ResetUsername, StringFormat='Setting new credentials for: {0}'}" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <TextBlock Text="New Password *" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                    <TextBlock Text="Must contain min 8 chars, 1 uppercase, 1 lowercase, 1 number, and 1 special symbol."
                               Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,0,0,12"/>

                    <CheckBox Content="Force password change on next login" IsChecked="{Binding ResetMustChangePassword}" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource NavButton}" Command="{Binding CloseDialogCommand}" Margin="0,0,10,0"/>
                        <Button Content="Confirm Reset" Style="{StaticResource DangerButton}" Command="{Binding ExecuteResetPasswordCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>