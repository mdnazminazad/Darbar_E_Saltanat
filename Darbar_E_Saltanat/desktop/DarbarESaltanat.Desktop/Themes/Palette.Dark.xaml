<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      DARK palette. Added on top of Royal.xaml by AppTheme when dark mode is on (and removed again for light mode).
      It must re-declare every key in Royal.xaml's "THEME-DEPENDENT" section — keep the two files in step.
    -->
    <SolidColorBrush x:Key="ContentBrush" Color="#0B1020"/>
    <SolidColorBrush x:Key="CardBrush" Color="#111831"/>
    <SolidColorBrush x:Key="CardAltBrush" Color="#1A2342"/>
    <SolidColorBrush x:Key="BorderSoftBrush" Color="#2A3560"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#3B4878"/>
    <SolidColorBrush x:Key="InputBgBrush" Color="#0B1020"/>
    <SolidColorBrush x:Key="TextBrush" Color="#E5E9F5"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9AA7C7"/>
    <SolidColorBrush x:Key="LabelBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="HeadingBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#F0D68A"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FDA4AF"/>
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#4ADE80"/>
    <SolidColorBrush x:Key="ButtonNeutralBrush" Color="#26315A"/>
    <SolidColorBrush x:Key="PrimaryBgBrush" Color="#26315A"/>
    <SolidColorBrush x:Key="KeyBrush" Color="#26315A"/>
    <SolidColorBrush x:Key="RowAltBrush" Color="#141C38"/>
    <SolidColorBrush x:Key="ErrorBannerBrush" Color="#3A1624"/>
    <SolidColorBrush x:Key="WarnBannerBrush" Color="#3A2E10"/>
    <SolidColorBrush x:Key="OkBannerBrush" Color="#10301F"/>
    <SolidColorBrush x:Key="ChipBrush" Color="#232C5C"/>
    <SolidColorBrush x:Key="BadgeAmberBgBrush" Color="#4A3A10"/>
    <SolidColorBrush x:Key="BadgeAmberFgBrush" Color="#FCD34D"/>
    <SolidColorBrush x:Key="BadgeIndigoBgBrush" Color="#2A3270"/>
    <SolidColorBrush x:Key="BadgeIndigoFgBrush" Color="#C7D2FE"/>
    <BitmapImage x:Key="LogoHorizontal" UriSource="pack://application:,,,/Assets/logo_horizontal_gold.png"/>

    <!-- Selection colours used by list/grid rows and text selection (system defaults are bright blue). -->
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#34427A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#26315A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#E5E9F5"/>
</ResourceDictionary>
