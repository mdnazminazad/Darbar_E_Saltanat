<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Darbar_E_Saltanat royal theme.
      * Brand colours (navy / gold / maroon) are the same in light and dark mode.
      * Everything under "THEME-DEPENDENT" holds the LIGHT values. Themes/Palette.Dark.xaml re-declares every one of
        those keys; AppTheme adds/removes that dictionary at run time. Always refer to them with {DynamicResource ...}
        so a screen follows the switch instantly.
    -->

    <!-- ===== Brand colours (never change with the theme) ===== -->
    <Color x:Key="NavyDarkColor">#0B1020</Color>
    <Color x:Key="NavyColor">#111831</Color>
    <Color x:Key="NavyLightColor">#1A2342</Color>
    <Color x:Key="GoldColor">#D4A72C</Color>
    <Color x:Key="GoldLightColor">#F0D68A</Color>
    <Color x:Key="MaroonColor">#9B1C31</Color>
    <SolidColorBrush x:Key="NavyDarkBrush" Color="{StaticResource NavyDarkColor}"/>
    <SolidColorBrush x:Key="NavyBrush" Color="{StaticResource NavyColor}"/>
    <SolidColorBrush x:Key="NavyLightBrush" Color="{StaticResource NavyLightColor}"/>
    <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource GoldColor}"/>
    <SolidColorBrush x:Key="GoldLightBrush" Color="{StaticResource GoldLightColor}"/>
    <SolidColorBrush x:Key="MaroonBrush" Color="{StaticResource MaroonColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#15803D"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#B45309"/>

    <!-- ===== THEME-DEPENDENT (light values) ===== -->
    <SolidColorBrush x:Key="ContentBrush" Color="#F4F5F8"/>          <!-- window background -->
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>             <!-- cards, dialogs, status bar -->
    <SolidColorBrush x:Key="CardAltBrush" Color="#F8FAFC"/>          <!-- inner panels, search boxes -->
    <SolidColorBrush x:Key="BorderSoftBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="InputBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="LabelBrush" Color="#334155"/>
    <SolidColorBrush x:Key="HeadingBrush" Color="#111831"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#1A2342"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#9B1C31"/>
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#15803D"/>
    <SolidColorBrush x:Key="ButtonNeutralBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="PrimaryBgBrush" Color="#111831"/>
    <SolidColorBrush x:Key="KeyBrush" Color="#1A2342"/>
    <SolidColorBrush x:Key="RowAltBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="ErrorBannerBrush" Color="#FDECEF"/>
    <SolidColorBrush x:Key="WarnBannerBrush" Color="#FFF7E6"/>
    <SolidColorBrush x:Key="OkBannerBrush" Color="#E8F5EC"/>
    <SolidColorBrush x:Key="ChipBrush" Color="#EEF2FF"/>
    <SolidColorBrush x:Key="BadgeAmberBgBrush" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="BadgeAmberFgBrush" Color="#92400E"/>
    <SolidColorBrush x:Key="BadgeIndigoBgBrush" Color="#E0E7FF"/>
    <SolidColorBrush x:Key="BadgeIndigoFgBrush" Color="#3730A3"/>
    <BitmapImage x:Key="LogoHorizontal" UriSource="pack://application:,,,/Assets/logo_horizontal_for_light.png"/>

    <!-- ===== Window ===== -->
    <Style TargetType="Window" x:Key="RoyalWindow">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Background" Value="{DynamicResource ContentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <!-- ===== Buttons: touch-friendly base (min 48px high) ===== -->
    <Style x:Key="BaseButton" TargetType="Button">
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="Padding" Value="18,8"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="{DynamicResource ButtonNeutralBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.9"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.75"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{DynamicResource PrimaryBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource GoldLightBrush}"/>
    </Style>
    <Style x:Key="GoldButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource GoldBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource NavyDarkBrush}"/>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource MaroonBrush}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="KeypadButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{DynamicResource KeyBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="MinHeight" Value="64"/>
    </Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#CBD5E1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Margin" Value="0,2"/>
    </Style>

    <!-- ===== Text inputs ===== -->
    <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- ===== ComboBox (own template so it can be dark) ===== -->
    <ControlTemplate x:Key="RoyalComboToggle" TargetType="ToggleButton">
        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
            <Path x:Name="Arrow" Data="M 0 0 L 5 5 L 10 0" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GoldBrush}"/></Trigger>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GoldBrush}"/></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6,34,6"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Template="{StaticResource RoyalComboToggle}" Focusable="False" ClickMode="Press"
                                      Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True">
                                <Border x:Name="DropDownBorder" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Margin="0,2,0,0"/>
                                <ScrollViewer Margin="3,5,3,3" SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/></Trigger>
                        <Trigger Property="HasItems" Value="False"><Setter TargetName="DropDownBorder" Property="MinHeight" Value="40"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"/>
        <Setter Property="VerticalContentAlignment" Value="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonNeutralBrush}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonNeutralBrush}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Other controls: only colours, the built-in templates stay ===== -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style TargetType="ListBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="RowBackground" Value="{DynamicResource CardBrush}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource RowAltBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderSoftBrush}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource BorderSoftBrush}"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource CardAltBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource LabelBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="10,8"/>
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Shared text / card styles ===== -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,12,0,4"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource LabelBrush}"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="Heading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Georgia"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource HeadingBrush}"/>
    </Style>
</ResourceDictionary>
