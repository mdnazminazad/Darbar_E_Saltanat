# Copy to web/server/.env and fill in. See docs/setup.md and docs/deployment.md.
NODE_ENV=production
PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=darbar_e_saltanat
DB_USER=darbar_app
DB_PASSWORD=change-me
# openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-64-random-hex-characters-0000000000000000000000000000
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
BCRYPT_ROUNDS=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
CORS_ORIGINS=https://darbaresaltanat.com
REQUIRE_HTTPS=true
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
LOG_LEVEL=info
# web/client build-time (optional): VITE_API_BASE_URL=/api/v1
